rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Course media uploaded by trainer for their own course scope.
    match /courses/{trainerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(trainerId);
    }

    // Certificates generated via Cloud Functions and read by owner.
    match /certificates/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
