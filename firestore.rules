rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Trainers can read student profiles for enrolled courses
      allow read: if request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer';
    }
    
    // Courses: public read, trainers manage own courses
    match /courses/{courseId} {
      allow read: if true;  // Public course catalog
      allow create, update, delete: if request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
        && (!resource.data.keys().hasAll(['trainerId']) || resource.data.trainerId == request.auth.uid);
    }
    
    // Course modules: trainers + enrolled students
    match /courses/{courseId}/modules/{moduleId} {
      allow read, write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer' &&
        resource.data.courseId == courseId
      ) || exists(/databases/$(database)/documents/enrollments/$(request.auth.uid)_$(courseId));
    }
    
    // Lessons within modules
    match /courses/{courseId}/modules/{moduleId}/lessons/{lessonId} {
      allow read, write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer' ||
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid)_$(courseId))
      );
    }
    
    // Enrollments: students own, trainers own course students
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer' &&
         resource.data.courseId in get(/databases/$(database)/documents/courses/{courseId}).data.trainerId == request.auth.uid)
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Progress tracking per enrollment
    match /progress/{userId}/{courseId} {
      allow read, write: if request.auth != null && userId == request.auth.uid;
    }
    
    // Reviews: enrolled students only
    match /reviews/{reviewId} {
      allow create, update, delete: if request.auth != null 
        && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid)_$(resource.data.courseId));
      allow read: if true;  // Public reviews
    }
    
    // Certificates: issued to students, public verification
    match /certificates/{certId} {
      allow read: if true;  // Public verification by certId
      allow create, update: if request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['trainer', 'admin']
        && resource.data.userId == request.auth.uid;  // Trainers issue own students' certs
    }
    
    // Payments: students create, trainers/admins read
    match /payments/{paymentId} {
      allow create, read, update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['trainer', 'admin'];
    }
    
    // Admin full access
    match /{document=**} {
      allow read, write: if request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
