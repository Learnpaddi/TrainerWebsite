rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: read/write own profile
    match /users/{userId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId 
        && (request.resource == null 
            || request.resource.data.keys().hasAll(['email', 'name', 'role', 'enrolledCourses']));
      allow create: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'name', 'role']);
    }
    
    // Public course read, admin write
    match /courses/{courseId} {
      allow read: if true; // Published courses public
      allow list: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }
    
    // Course subcollections (modules/lessons) - enrolled read, admin write  
    match /courses/{courseId}/{document=**} {
      allow read: if isEnrolled(courseId);
      allow write: if isAdmin();
    }
    
    // Enrollments: user own
    match /enrollments/{docId} {
      allow read, write: if request.auth != null 
        && resource != null 
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Progress: user own
    match /user_progress/{docId} {
      allow read, write: if request.auth != null 
        && (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Payments: user own + admin read
    match /payments/{paymentId} {
      allow read, create, update: if request.auth != null 
        && (resource == null || resource.data.userId == request.auth.uid);
      allow read: if isAdmin();
    }
    
    // Reviews: authenticated users
    match /course_reviews/{docId} {
      allow read: if true;
      allow create: if request.auth != null && isEnrolled(resource.data.courseId);
    }
    
    // Helpers
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isEnrolled(courseId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null 
        && courseId in userDoc.data.enrolledCourses;
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Thumbnails public read
    match /courses/{courseId}/{allPaths=**} {
      allow read: if true;
    }
    
    // User uploads (profile pics) - user write
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Lesson content - enrolled read
    match /lessons/{lessonId}/{allPaths=**} {
      allow read: if true; // Videos public for streaming
    }
  }
}
