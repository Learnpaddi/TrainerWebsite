rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myUserDoc() {
      return userDoc(request.auth.uid);
    }

    function isAdmin() {
      return signedIn() && myUserDoc().data.role == 'admin';
    }

    function isTrainer() {
      return signedIn() && myUserDoc().data.role == 'trainer';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isStudentWritableEnrollmentCreate() {
      return request.resource.data.keys().hasOnly([
        'userId',
        'courseId',
        'progress',
        'completed',
        'completedAt',
        'enrolledAt',
        'updatedAt',
        'paymentStatus',
        'status',
        'completedLessons',
        'currentLessonId'
      ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.courseId is string
      && !('score' in request.resource.data)
      && !('passed' in request.resource.data)
      && !('certificateUrl' in request.resource.data)
      && !('certificateId' in request.resource.data)
      && !('examAttempted' in request.resource.data)
      && (
        !(request.resource.data.courseId is string) ||
        (
          courseDoc(request.resource.data.courseId).data.price > 0
            ? request.resource.data.paymentStatus == 'pending'
            : request.resource.data.paymentStatus in ['not_required', null]
        )
      );
    }

    function isStudentWritableEnrollmentUpdate() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'progress',
          'completed',
          'completedAt',
          'updatedAt',
          'status',
          'completedLessons',
          'currentLessonId'
        ]);
    }

    function isStudentWritableProgress() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedLessons',
          'totalLessons',
          'percentage',
          'updatedAt'
        ]);
    }

    function courseDoc(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId));
    }

    function isCourseTrainer(courseId) {
      return signedIn() && courseDoc(courseId).data.trainerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isTrainer() || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['student', 'trainer'];
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if signedIn()
        && request.auth.uid == resource.data.trainerId;
    }

    match /exams/{examId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isTrainer();
    }

    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTrainer(resource.data.courseId) ||
        isAdmin()
      );
      allow create: if signedIn() && isStudentWritableEnrollmentCreate();
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid && isStudentWritableEnrollmentUpdate()) ||
        isAdmin()
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /progress/{progressId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTrainer(resource.data.courseId) ||
        isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !('examScore' in request.resource.data)
        && !('examPercentage' in request.resource.data)
        && !('examPassed' in request.resource.data)
        && !('certificateUrl' in request.resource.data)
        && !('certificateIssuedAt' in request.resource.data);
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid && isStudentWritableProgress()) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTrainer(resource.data.courseId) ||
        isAdmin()
      );
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
