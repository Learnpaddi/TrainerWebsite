rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myUserDoc() {
      return userDoc(request.auth.uid);
    }

    function isAdmin() {
      return signedIn() && myUserDoc().data.role == 'admin';
    }

    function isTrainer() {
      return signedIn() && myUserDoc().data.role == 'trainer';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function courseDoc(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId));
    }

    function isCourseTrainer(courseId) {
      return signedIn() && courseDoc(courseId).data.trainerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isTrainer() || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['student', 'trainer'];
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create: if (isTrainer() && request.resource.data.trainerId == request.auth.uid) || isAdmin();
      allow update, delete: if (isCourseTrainer(courseId)
        && request.resource.data.trainerId == resource.data.trainerId) || isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTrainer(resource.data.courseId) ||
        isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.courseId is string;
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTrainer(resource.data.courseId) ||
        isAdmin()
      );
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Document id convention: {userId}_{courseId}
    match /progress/{progressId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTrainer(resource.data.courseId) ||
        isAdmin()
      );
      allow create, update: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isCourseTrainer(request.resource.data.courseId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTrainer(resource.data.courseId) ||
        isAdmin()
      );
      allow create, update: if signedIn() && (
        isCourseTrainer(request.resource.data.courseId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
