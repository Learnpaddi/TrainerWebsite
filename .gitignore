# Git ignore for Netlify filename safety - block # and ? chars
!.gitignore
*#*
*?*
**/*.#
**/*.?

# Standard ignores
node_modules/
.DS_Store
.env
*.log
firebase-debug.log
firestore-debug.log
.nyc_output
coverage/
.nyc_output
!.vscode/extensions.json
.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

